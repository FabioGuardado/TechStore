@model TechStore.Models.CardViewModel

@{
    ViewData["Title"] = Model?.Title ?? "Detalle";

    var img = string.IsNullOrEmpty(Model?.ImageUrl) ? "/images/placeholder.png"
                          : (Model.ImageUrl.StartsWith("/") ? Model?.ImageUrl : $"/images/{Model?.ImageUrl}");
}

<div class="container my-4">
    <div class="row">
        <div class="col-md-6">
            <img src="@img" class="img-fluid img-card" alt="@Model.Title" />
            <a asp-controller="Products" asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-secondary mt-3">Editar producto</a>
            <form asp-controller="Products" asp-action="Eliminar" asp-route-id="@Model.Id" method="post" class="d-inline swal-delete-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger mt-3">Eliminar producto</button>
            </form>
        </div>
        <div class="col-md-6">
            <h1 class="brand-font">@Model.Title</h1>
            <p class="text-muted">@Model.Category</p>
            <h3 class="text-success">$@Model.Price</h3>
            <p>@Model.Description</p>
            <p><strong>Estado:</strong> @if (Model.State == "Disponible")
                {
                    <span class="badge bg-success">Disponible</span>
                }
                else
                {
                    <span class="badge bg-danger">No disponible</span>
                }
            </p>
            <p><strong>Stock:</strong> @Model.Stock</p>

            <div class="d-flex gap-2 mt-3">
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Volver a productos</a>
                <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-primary">Voler a Categorías</a>
                <button class="btn btn-primary" @(Model.Stock == 0 ? "disabled" : "")>Añadir al carrito</button>
            </div>
        </div>
    </div>
</div>