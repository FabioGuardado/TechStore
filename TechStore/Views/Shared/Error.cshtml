@model ErrorViewModel
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="container py-5 text-center">
    <p class="display-1 fw-bold text-danger">@Model.Codigo</p>
    <h1 class="h3">@Model.Titulo</h1>
    <p class="text-muted">@Model.Mensaje</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">
            Código de referencia: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
</div>
